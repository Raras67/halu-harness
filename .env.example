# === Router Configuration ===
# Base URL endpoint OpenAI-compatible. Ganti sesuai router Anda.
# CleanAPIs contoh: https://api.cleanapis.com/v1
# OpenRouter:      https://openrouter.ai/api/v1
# Together:        https://api.together.xyz/v1
# Groq:            https://api.groq.com/openai/v1
# Fireworks:       https://api.fireworks.ai/inference/v1
# xAI direct:      https://api.x.ai/v1
# Local (Ollama):  http://localhost:11434/v1
ROUTER_BASE_URL=put here
ROUTER_API_KEY=sk-your-api-key-here

#answer model (change with your choice)
ANSWER_MODEL_GEMINI=google/gemini-2.5-flash
ANSWER_MODEL_GROK=x-ai/grok-4-fast

#judge model ( change with your choice )
JUDGE_MODEL=google/gemini-2.5-flash

# === Optional: fallback if route header needed
ROUTER_HTTP_REFERER=
ROUTER_X_TITLE=llm-eval-portfolio
